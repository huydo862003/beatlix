    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
